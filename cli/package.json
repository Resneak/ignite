{
    "name": "IgniteCLI",
    "version": "0.7.0",
    "bin": "./bundled/login.prod.js",
    "pkg": {
        "scripts": "./bundled/login.prod.js",
        "assets": [
            "../lib/assets/**.pub",
            "../lib/assets/**.mp3",
            "./bundled/darwin/*",
            "./bundled/win32/*",
            "./bundled/http.proto",
            "node_modules/puppeteer-extra-plugin-stealth/**/*.*"
        ],
        "options": [
            "--no-warnings"
        ],
        "targets": [
            "node14-win-x64"
        ],
        "outputPath": "production"
    },
    "scripts": {
        "webpack-prod": "webpack --config webpack.prod.js",
        "webpack-dev": "webpack --config webpack.dev.js",
        "start": "tsc && run webpack-prod && cross-env NODE_ENV=production node --no-warnings bundled/login.prod.js",
        "start-dev": "tsc && node ./node_modules/gulp/bin/gulp.js && npm run webpack-dev && cross-env NODE_ENV=development node bundled/login.dev.js",
        "prefast": "concurrently \"npm run webpack-dev\" \"node ./node_modules/gulp/bin/gulp.js\"",
        "fast": "cross-env NODE_ENV=development node bundled/login.dev.js",
        "pack": "pkg .",
        "exe": "node ./node_modules/gulp/bin/gulp.js production && npm run webpack-prod && npm run pack && node --max_old_space_size=4095 ./node_modules/gulp/bin/gulp.js zip",
        "debug": "tsc && npm run webpack-dev && cross-env NODE_ENV=development node --inspect bundled/login.dev.js"
    },
    "devDependencies": {
        "@babel/core": "^7.13.15",
        "@babel/plugin-proposal-class-properties": "^7.13.0",
        "@babel/preset-env": "^7.13.15",
        "@babel/preset-typescript": "^7.13.0",
        "@types/got": "^9.6.11",
        "@types/inquirer": "^7.3.1",
        "@types/node": "^14.14.34",
        "@types/promise-queue": "^2.2.0",
        "@types/tunnel": "0.0.2",
        "@types/uuid": "^8.3.0",
        "@types/winreg": "^1.2.30",
        "babel-loader": "^8.2.2",
        "babel-plugin-minify-dead-code-elimination": "^0.5.1",
        "concurrently": "^6.2.0",
        "cross-env": "^7.0.3",
        "eslint": "^7.18.0",
        "gulp": "^4.0.2",
        "gulp-zip": "^5.1.0",
        "pkg": "^4.4.9",
        "rcedit": "^3.0.0",
        "ts-node": "^9.1.1",
        "typescript": "^4.3.0-beta",
        "webpack": "^5.32.0",
        "webpack-cli": "^4.6.0",
        "webpack-merge": "^5.7.3",
        "webpack-node-externals": "^2.5.2",
        "webpack-obfuscator": "^3.3.0"
    },
    "dependencies": {
        "2captcha": "^2.1.5-2",
        "autosolve-client": "^2.1.3",
        "chalk": "^4.1.0",
        "clipboardy": "^2.3.0",
        "credit-card-type": "^9.1.0",
        "crypto": "^1.0.1",
        "discord-rich-presence": "^0.0.8",
        "discord-rpc": "^4.0.1",
        "form-data": "^2.5.1",
        "fs": "*",
        "got": "^11.8.1",
        "inquirer": "^8.0.0",
        "jssha": "^3.2.0",
        "log-symbols": "^4.0.0",
        "path": "^0.12.7",
        "promise-queue": "^2.2.5",
        "puppeteer": "^10.1.0",
        "puppeteer-extra": "^3.1.18",
        "puppeteer-extra-plugin-stealth": "^2.7.8",
        "tough-cookie": "^4.0.0",
        "tslib": "^2.3.0",
        "uuid": "^8.3.2",
        "winreg": "^1.2.4"
    }
}
